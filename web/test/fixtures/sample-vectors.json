   {"pipeline": "nf-core/rnaseq", "id": "tumour_2", "run": "r1"},
   {"pipeline": "nf-core/rnaseq", "id": "T2", "run": "r2"}],
  "inputs": [],
  "claims": [
   {"a": {"pipeline": "nf-core/rnaseq", "id": "tumour_2", "run": "r1"}, "b": {"pipeline": "nf-core/rnaseq", "id": "T2", "run": "r2"}, "same": true}],
  "expect": [
   {"label": "T2", "basis": "sample ID", "occurrences": ["r1/tumour_2", "r2/T2"]}]},

 {"name": "a sample's label is its most common meta.id",
