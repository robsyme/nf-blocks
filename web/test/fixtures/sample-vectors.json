[
 {"name": "the same name across runs of one pipeline is one sample",
  "occurrences": [
   {"pipeline": "nf-core/rnaseq", "id": "A", "run": "r1"},
   {"pipeline": "nf-core/rnaseq", "id": "A", "run": "r2"},
   {"pipeline": "nf-core/rnaseq", "id": "B", "run": "r1"}],
  "inputs": [], "claims": [],
  "expect": [
   {"label": "A", "basis": "sample ID", "occurrences": ["r1/A", "r2/A"]},
   {"label": "B", "basis": "sample ID", "occurrences": ["r1/B"]}]},

 {"name": "the same name in two pipelines is two samples",
  "occurrences": [
   {"pipeline": "nf-core/rnaseq", "id": "A", "run": "r1"},
   {"pipeline": "nf-core/sarek", "id": "A", "run": "r2"}],
  "inputs": [], "claims": [],
  "expect": [
   {"label": "A", "basis": "sample ID", "occurrences": ["r1/A"]},
   {"label": "A", "basis": "sample ID", "occurrences": ["r2/A"]}]},

 {"name": "a shared input address joins different meta.ids, across pipelines",
  "occurrences": [
   {"pipeline": "nf-core/rnaseq", "id": "WT_1", "run": "r1"},
   {"pipeline": "nf-core/sarek", "id": "wt-rep1", "run": "r2"}],
  "inputs": [
   {"completion_cid": "r1", "role": "task", "name": "WT_1_R1.fastq.gz", "address": "x1", "size": 10, "sample": "WT_1"},
   {"completion_cid": "r2", "role": "task", "name": "WT_1_R1.fastq.gz", "address": "x1", "size": 10, "sample": "wt-rep1"}],
  "claims": [],
  "expect": [
   {"label": "WT_1", "basis": "input reads", "occurrences": ["r1/WT_1", "r2/wt-rep1"]}]},

 {"name": "the same name with disjoint inputs stays apart",
  "occurrences": [
   {"pipeline": "nf-core/rnaseq", "id": "A", "run": "r1"},
