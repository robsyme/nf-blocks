  "inputs": [],
  "claims": [
   {"a": {"pipeline": "nf-core/rnaseq", "id": "A", "run": "r1"}, "b": {"pipeline": "nf-core/rnaseq", "id": "A", "run": "r2"}, "same": false},
   {"a": {"pipeline": "nf-core/rnaseq", "id": "A", "run": "r2"}, "b": {"pipeline": "nf-core/rnaseq", "id": "A", "run": "r1"}, "same": true}],
  "expect": [
