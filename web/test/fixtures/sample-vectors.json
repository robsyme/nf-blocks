 {"name": "a split takes b out of a's automatic group",
  "occurrences": [
   {"pipeline": "nf-core/rnaseq", "id": "A", "run": "r1"},
   {"pipeline": "nf-core/rnaseq", "id": "A", "run": "r2"},
   {"pipeline": "nf-core/rnaseq", "id": "A", "run": "r3"}],
  "inputs": [],
  "claims": [
   {"a": {"pipeline": "nf-core/rnaseq", "id": "A", "run": "r1"}, "b": {"pipeline": "nf-core/rnaseq", "id": "A", "run": "r3"}, "same": false}],
  "expect": [
   {"label": "A", "basis": "sample ID", "occurrences": ["r1/A", "r2/A"]},
   {"label": "A", "basis": "sample ID", "occurrences": ["r3/A"]}]},

 {"name": "a split between occurrences in different groups changes nothing",
  "occurrences": [
   {"pipeline": "nf-core/rnaseq", "id": "A", "run": "r1"},
   {"pipeline": "nf-core/rnaseq", "id": "B", "run": "r2"}],
  "inputs": [],
  "claims": [
   {"a": {"pipeline": "nf-core/rnaseq", "id": "A", "run": "r1"}, "b": {"pipeline": "nf-core/rnaseq", "id": "B", "run": "r2"}, "same": false}],
  "expect": [
   {"label": "A", "basis": "sample ID", "occurrences": ["r1/A"]},
   {"label": "B", "basis": "sample ID", "occurrences": ["r2/B"]}]},

 {"name": "a merge joins two samples; the label tie goes to the alphabetical first",
