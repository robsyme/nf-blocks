   {"label": "A", "basis": "input reads", "occurrences": ["r2/A"]}]},

 {"name": "the same name joins when only one side has input rows; the basis is the sample ID",
  "occurrences": [
   {"pipeline": "nf-core/rnaseq", "id": "A", "run": "r1"},
