   {"completion_cid": "r1", "role": "samplesheet", "name": "samplesheet.csv", "address": "s1", "size": 10, "sample": "A"},
   {"completion_cid": "r2", "role": "samplesheet", "name": "samplesheet.csv", "address": "s1", "size": 10, "sample": "B"},
   {"completion_cid": "r1", "role": "param:fasta", "name": "genome.fa", "address": "g1", "size": 10, "sample": "A"},
   {"completion_cid": "r2", "role": "param:fasta", "name": "genome.fa", "address": "g1", "size": 10, "sample": "B"},
   {"completion_cid": "r2", "role": "task", "name": "B_R1.fastq.gz", "address": "x1", "size": 10, "sample": "Z"},
   {"completion_cid": "r3", "role": "task", "name": "C_R1.fastq.gz", "address": "x1", "size": 10, "sample": "C"}],
  "claims": [],
  "expect": [
   {"label": "A", "basis": "sample ID", "occurrences": ["r1/A"]},
   {"label": "B", "basis": "sample ID", "occurrences": ["r2/B"]},
   {"label": "C", "basis": "input reads", "occurrences": ["r3/C"]}]},

