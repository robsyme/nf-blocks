  "inputs": [
   {"completion_cid": "r1", "role": "task", "name": "A_R1.fastq.gz", "address": "x1", "size": 10, "sample": "A"}],
  "claims": [],
  "expect": [
   {"label": "A", "basis": "sample ID", "occurrences": ["r1/A", "r2/A"]}]},

 {"name": "only task rows whose sample is the occurrence's meta.id count",
  "occurrences": [
   {"pipeline": "nf-core/rnaseq", "id": "A", "run": "r1"},
   {"pipeline": "nf-core/rnaseq", "id": "B", "run": "r2"},
