// The Gate's config overlay for the Test Pipeline. Applied with
//   nextflow run . -c <abs path>/gate/gate.config
// on top of the Test Pipeline's own nextflow.config, which it overrides:
// lineage goes to the cas:// store instead of ./.lineage, and outputDir
// publishes through the store instead of into ./results.

plugins {
    // Pinned: an unpinned id sends Nextflow to the plugin registry, which
    // does not know nf-blocks, and the run dies with
    // "Cannot find latest version of nf-blocks plugin".
    id 'nf-blocks@0.3.0-beta.2'
}

// Pipeline Identity (DESIGN section 6): the first non-null of cas.pipeline,
// manifest.name, projectName. `nextflow run .` gives projectName the literal
// string "main.nf", which is no identity at all, so the Gate names it here.
manifest.name = 'cas-test-pipeline'

lineage.enabled = true
lineage.store.location = 'cas://lab'
outputDir = 'cas://lab'

cas {
    stores {
        lab { location = System.getenv('GATE_STORE') }
    }
    asserted_by = 'gate'
}

// A dynamic directive and a unit literal, as nf-core's modules.config writes
// them. Both are valid strict config, and neither is a value dag-cbor can
// encode: the RunManifest records the resolved config as text (DESIGN
// section 6), and assertion 3 checks the closure's source is in it.
process {
    memory = 1.GB
    withName: '.*' {
        ext.args = { "--threads ${task.cpus}" }
    }
}
