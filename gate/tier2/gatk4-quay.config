// prototype/18/gatk4-quay.config -- sarek 3.10.0's GATK4 modules use
// community.wave.seqera.io/library/gatk4_gcnvkernel:edb12e4f0bf02cd3, whose 1.98 GB layer is over
// Cloudflare's 512 MB cache limit and came at ~300 KB/s (ticket 18, 2026-09-29). Same GATK
// (4.6.2.0) from biocontainers instead. GATK4_MARKDUPLICATES keeps sarek's own image (it bundles
// htslib and samtools, and pulled fine); GATK4SPARK_* do not match.
process {
    withName: '.*:GATK4_(?!MARKDUPLICATES).*' {
        container = 'quay.io/biocontainers/gatk4:4.6.2.0--py310hdfd78af_1'
    }
}
