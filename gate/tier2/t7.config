// gate/tier2/t7.config -- T7 (ticket 21 answer 7), applied last: gate/retention's two runs into cas-t7 on
// the local executor (T7 is about the S3 member, not Batch), undoing batch.config's executor, S3 workDir and
// trace; and the age floor of T7's sweep verbs.
process.executor = 'local'
workDir = 'work'
trace.enabled = false
// S3's LastModified cannot be backdated, so T7 uses the minimum age floor (plan decision 8: no less than the
// 10 minutes after which a registration is stale) and tier2.sh waits until everything T7's runs wrote is 11
// minutes old by S3's clock. A real store keeps the 14-day default.
cas.sweep.ageFloor = '10m'
