// recover-fail's overlay (assertion 19), applied by gate.sh after gate.config:
//   nextflow run . -c gate/gate.config -name recover-fail --fail -c gate/recovery/fail.config
//
// The resume after a failure needs a failed session whose finished tasks are
// the same every time. Under the default errorStrategy 'terminate' a run
// aborts on MAYBE_FAIL's exit 7 while some tasks are still running, and which
// ones finished is a race (issue 17 saw 2 to 12 of 15). 'finish' lets every
// submitted task complete before the run fails, and 16 local cpus let all 15
// be submitted at once on any machine, so all 14 other tasks finish.
// Measured on 26.04.6: three runs, each 14 completed and 1 failed, and each
// resume cached 12 and ran MAYBE_FAIL's 3 again.
process {
    withName: 'MAYBE_FAIL' {
        errorStrategy = 'finish'
    }
}

executor {
    cpus = 16
}
